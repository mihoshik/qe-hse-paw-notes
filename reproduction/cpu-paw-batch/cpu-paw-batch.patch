diff --git a/PW/src/exx_paw_cpu_batch.f90 b/PW/src/exx_paw_cpu_batch.f90
new file mode 100644
--- /dev/null
+++ b/PW/src/exx_paw_cpu_batch.f90
@@ -0,0 +1,170 @@
+! Experimental CPU US/PAW reciprocal-space augmentation, GPL as QE 7.6.
+! Same equations and DP precision as us_exx; triangular projector pairs,
+! BLAS-3 over the existing jblock, and phase/workspace reuse within one vexx.
+! The separate PAW one-center term stays in the repaired paw_exx module.
+MODULE exx_paw_cpu_batch
+  USE kinds, ONLY : DP
+  USE fft_types, ONLY : fft_type_descriptor
+  USE ions_base, ONLY : nat,nsp,ityp,tau
+  USE uspp, ONLY : nkb,ofsbeta,ijtoh
+  USE uspp_param, ONLY : nh,upf
+  USE gvect, ONLY : mill,eigts1,eigts2,eigts3
+  USE constants, ONLY : tpi
+  USE cell_base, ONLY : omega
+  USE io_global, ONLY : ionode,stdout
+  USE us_exx, ONLY : qgm,nij_type,addusxx_g,newdxx_g
+  IMPLICIT NONE
+  PRIVATE
+  PUBLIC :: paw_cpu_enabled,paw_cpu_init,paw_cpu_q,paw_cpu_add,paw_cpu_new,paw_cpu_finish
+  COMPLEX(DP), PARAMETER :: ONE=(1._DP,0._DP),ZERO=(0._DP,0._DP)
+  INTEGER :: ng,nijmax,checks_add=0,checks_new=0
+  LOGICAL :: validate=.false.,announced=.false.
+  REAL(DP) :: qleft(3),qright(3),max_add_error=0._DP,max_new_error=0._DP
+  COMPLEX(DP), ALLOCATABLE :: phase0(:,:),phase(:,:),coeff(:,:),work(:,:)
+CONTAINS
+  LOGICAL FUNCTION paw_cpu_enabled()
+    CHARACTER(32) :: flag
+    INTEGER :: status
+    CALL get_environment_variable('QE_PAW_CPU_BATCH',flag,status=status)
+    paw_cpu_enabled = .true.
+    IF (status==0) paw_cpu_enabled = TRIM(flag)/='0'
+  END FUNCTION
+
+  SUBROUTINE paw_cpu_init(grid,bands)
+    TYPE(fft_type_descriptor), INTENT(IN) :: grid
+    INTEGER, INTENT(IN) :: bands
+    INTEGER :: na,ig,status
+    CHARACTER(32) :: flag
+    IF (ALLOCATED(phase)) CALL errore('paw_cpu_init','workspace already active',1)
+    ng=grid%ngm; nijmax=MAX(1,MAXVAL(nh*(nh+1)/2))
+    ALLOCATE(phase0(ng,nat),phase(ng,nat),coeff(nijmax,bands),work(MAX(1,ng),bands))
+    DO na=1,nat
+      DO ig=1,ng
+        phase0(ig,na)=eigts1(mill(1,ig),na)*eigts2(mill(2,ig),na)*eigts3(mill(3,ig),na)
+      ENDDO
+    ENDDO
+    CALL get_environment_variable('QE_PAW_CPU_VALIDATE',flag,status=status)
+    validate=status==0 .AND. TRIM(flag)=='1'
+    ! Validation covers EVERY batch/q of this invocation, not a process-lifetime sample.
+    checks_add=0;checks_new=0;max_add_error=0._DP;max_new_error=0._DP
+    IF (.NOT.announced .AND. ionode) THEN
+      WRITE(stdout,'(A,L1)') '     Experimental CPU batched augmentation ACTIVE; validation=',validate
+      announced=.true.
+    ENDIF
+  END SUBROUTINE
+
+  SUBROUTINE paw_cpu_q(left,right)
+    REAL(DP), INTENT(IN) :: left(3),right(3)
+    REAL(DP) :: arg
+    COMPLEX(DP) :: z
+    INTEGER :: na
+    qleft=left;qright=right
+    DO na=1,nat
+      arg=tpi*SUM((right-left)*tau(:,na))
+      z=CMPLX(COS(arg),-SIN(arg),DP)
+      phase(:,na)=z*phase0(:,na)
+    ENDDO
+  END SUBROUTINE
+
+  SUBROUTINE paw_cpu_add(grid,rho,bands,phi,psi)
+    TYPE(fft_type_descriptor), INTENT(IN) :: grid
+    INTEGER, INTENT(IN) :: bands
+    COMPLEX(DP), INTENT(INOUT) :: rho(:,:)
+    COMPLEX(DP), INTENT(IN) :: phi(nkb,bands),psi(nkb)
+    INTEGER :: na,nt,h,off,nij,qoff,p,b,ig,i,j
+    COMPLEX(DP) :: z
+    COMPLEX(DP), ALLOCATABLE :: reference(:,:)
+    REAL(DP) :: err
+    CALL start_clock('aug_cpu_add')
+    IF (validate) THEN
+      ALLOCATE(reference(grid%nnr,bands));reference=rho(:,1:bands)
+    ENDIF
+    IF (ng>0) THEN
+      DO na=1,nat
+        nt=ityp(na)
+        IF (.NOT.upf(nt)%tvanp) CYCLE
+        h=nh(nt);off=ofsbeta(na);nij=h*(h+1)/2;qoff=nij_type(nt)
+        DO b=1,bands
+          p=0
+          DO i=1,h
+            DO j=i,h
+              p=p+1
+              z=CONJG(phi(off+i,b))*psi(off+j)
+              IF (i/=j) z=z+CONJG(phi(off+j,b))*psi(off+i)
+              coeff(p,b)=z
+            ENDDO
+          ENDDO
+        ENDDO
+        CALL ZGEMM('N','N',ng,bands,nij,ONE,qgm(1,qoff+1),ng,coeff,nijmax,ZERO,work,MAX(1,ng))
+        DO b=1,bands
+          DO ig=1,ng
+            rho(grid%nl(ig),b)=rho(grid%nl(ig),b)+phase(ig,na)*work(ig,b)
+          ENDDO
+        ENDDO
+      ENDDO
+    ENDIF
+    IF (validate) THEN
+      DO b=1,bands
+        CALL addusxx_g(grid,reference(:,b),qleft,qright,'c',becphi_c=phi(:,b),becpsi_c=psi)
+      ENDDO
+      err=MAXVAL(ABS(rho(:,1:bands)-reference));max_add_error=MAX(max_add_error,err)
+      IF (err>5.e-11_DP*(1._DP+MAXVAL(ABS(reference)))) CALL errore('paw_cpu_add','stock/batch mismatch',1)
+      checks_add=checks_add+1;DEALLOCATE(reference)
+    ENDIF
+    CALL stop_clock('aug_cpu_add')
+  END SUBROUTINE
+
+  SUBROUTINE paw_cpu_new(grid,vc,bands,phi,deexx)
+    TYPE(fft_type_descriptor), INTENT(IN) :: grid
+    INTEGER, INTENT(IN) :: bands
+    COMPLEX(DP), INTENT(IN) :: vc(:,:),phi(nkb,bands)
+    COMPLEX(DP), INTENT(INOUT) :: deexx(nkb)
+    INTEGER :: na,nt,h,off,nij,qoff,ig,b,i,j,p
+    COMPLEX(DP) :: z
+    COMPLEX(DP), ALLOCATABLE :: reference(:)
+    REAL(DP) :: err
+    CALL start_clock('aug_cpu_new')
+    IF (validate) THEN
+      ALLOCATE(reference(nkb));reference=deexx
+    ENDIF
+    IF (ng>0) THEN
+      DO na=1,nat
+        nt=ityp(na)
+        IF (.NOT.upf(nt)%tvanp) CYCLE
+        h=nh(nt);off=ofsbeta(na);nij=h*(h+1)/2;qoff=nij_type(nt)
+        DO b=1,bands
+          DO ig=1,ng
+            work(ig,b)=vc(grid%nl(ig),b)*CONJG(phase(ig,na))
+          ENDDO
+        ENDDO
+        CALL ZGEMM('C','N',nij,bands,ng,CMPLX(omega,0._DP,DP),qgm(1,qoff+1),ng, &
+                   work,MAX(1,ng),ZERO,coeff,nijmax)
+        DO i=1,h
+          z=ZERO
+          DO b=1,bands
+            DO j=1,h
+              p=ijtoh(i,j,nt)
+              z=z+phi(off+j,b)*coeff(p,b)
+            ENDDO
+          ENDDO
+          deexx(off+i)=deexx(off+i)+z
+        ENDDO
+      ENDDO
+    ENDIF
+    IF (validate) THEN
+      DO b=1,bands
+        CALL newdxx_g(grid,vc(:,b),qleft,qright,'c',reference,becphi_c=phi(:,b))
+      ENDDO
+      err=MAXVAL(ABS(deexx-reference));max_new_error=MAX(max_new_error,err)
+      IF (err>5.e-11_DP*(1._DP+MAXVAL(ABS(reference)))) CALL errore('paw_cpu_new','stock/batch mismatch',1)
+      checks_new=checks_new+1;DEALLOCATE(reference)
+    ENDIF
+    CALL stop_clock('aug_cpu_new')
+  END SUBROUTINE
+
+  SUBROUTINE paw_cpu_finish()
+    IF (validate .AND. ionode) WRITE(stdout,'(A,2I8,2ES16.7)') &
+      '     CPU batch validation counts/errors: ',checks_add,checks_new,max_add_error,max_new_error
+    DEALLOCATE(phase0,phase,coeff,work)
+  END SUBROUTINE
+END MODULE
